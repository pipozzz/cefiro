NODE_ENV=development

# Core settings (required)
AUTH_URL=http://localhost:3000 # The URL where Norish is reachable
DATABASE_URL=postgres://postgres:norish@localhost:5432/norish
MASTER_KEY=<32-byte-base64-key>    # Generate with: openssl rand -base64 32
OBSCURA_ENDPOINT=ws://localhost:9222   # Obscura CDP endpoint used to render pages for URL imports
REDIS_URL=redis://localhost:6379   # Redis connection URL for real-time events and job queues
NEXT_PUBLIC_LOG_LEVEL=info         # trace, debug, info, warn, error, fatal (default: info in prod, debug in dev)

# Optional
UPLOADS_DIR=/app/uploads                # Defaults to ./.runtime/uploads in development, /app/uploads in production
# YT_DLP_BIN_DIR=/app/bin               # Defaults to ./.runtime/bin in development, /app/bin in production

# ─────────────────────────────────────────────────────────────────────────
# MEDIA STORAGE (images & videos)
# ─────────────────────────────────────────────────────────────────────────
# "fs" (default) keeps uploads on the UPLOADS_DIR volume. "s3" stores every
# image/video in any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, B2) —
# no persistent volume needed. The app still proxies the bytes through its own
# media routes, so the bucket can stay PRIVATE (no public access / CORS / custom
# domain) and stored URLs are identical either way. S3_* are required only when
# STORAGE_DRIVER=s3. Note: switching driver only affects NEW uploads — copy any
# existing files from UPLOADS_DIR into the bucket (e.g. rclone/aws s3 sync).
# STORAGE_DRIVER=s3
# Cloudflare R2 example (Account ID from the R2 dashboard; keys from
# "Manage R2 API Tokens"):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto                        # R2 uses "auto"; real AWS uses its region
# S3_BUCKET=cefiro-media
# S3_ACCESS_KEY_ID=<access-key-id>      # secret — never commit
# S3_SECRET_ACCESS_KEY=<secret-access-key>  # secret — never commit
# S3_FORCE_PATH_STYLE=true              # true for R2/MinIO/B2 (default); false for real AWS S3
# S3_PREFIX=cefiro-prod                 # optional key prefix, so one bucket can hold several envs
# PARSER_API_TIMEOUT_MS=15000           # Timeout for parser API calls in milliseconds
# NEXT_PUBLIC_LOG_LEVEL=info            # trace, debug, info, warn, error, fatal
# TRUSTED_ORIGINS=http://192.168.1.100:3000,https://norish.example.com  # Additional trusted origins, comma separated. Useful when behind a proxy or using multiple domains.

# Internationalization
# DEFAULT_LOCALE=en                # Instance default locale (must match a supported locale, defaults to 'en')
# ENABLED_LOCALES=en,de,nl         # Comma-separated locale list (empty = all locales enabled)

# ─────────────────────────────────────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────────────────────────────────────
# Optional. Email (household + instance invites) is sent only when SMTP_HOST and
# EMAIL_FROM are BOTH set; otherwise the mailer is a no-op and invites fall back
# to a shareable link. Set on both the web and worker services.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                          # default: 587
# SMTP_SECURE=false                      # true for port 465 (implicit TLS); false for 587 (STARTTLS)
# SMTP_USER=<smtp-username>              # omit for an unauthenticated relay
# SMTP_PASSWORD=<smtp-password>          # secret — never commit
# EMAIL_FROM="Naša Kuchyňa <noreply@example.com>"

# ─────────────────────────────────────────────────────────────────────────
# EMBEDDINGS (Voyage AI) — semantic discovery themes
# ─────────────────────────────────────────────────────────────────────────
# Optional. When VOYAGE_API_KEY is unset, recipe embedding + theme clustering
# no-op and /discover falls back to tag-based themes. Requires the pgvector
# Postgres image (see docker/). Set on BOTH the web and worker services.
# VOYAGE_API_KEY=<voyage-api-key>        # secret — never commit
# VOYAGE_MODEL=voyage-3                  # default: voyage-3 (1024-dim)
# VOYAGE_ENDPOINT=https://api.voyageai.com/v1/embeddings

# ─────────────────────────────────────────────────────────────────────────
# WEB PUSH (VAPID) — browser push notifications
# ─────────────────────────────────────────────────────────────────────────
# Optional. When the keys are unset, push is unavailable and the Settings toggle
# is hidden. Generate a key pair once: `npx web-push generate-vapid-keys`. Set
# the SAME values on both the web and worker services.
# VAPID_PUBLIC_KEY=<vapid-public-key>
# VAPID_PRIVATE_KEY=<vapid-private-key>  # secret — never commit
# VAPID_SUBJECT=mailto:admin@example.com # default: mailto:admin@nasakuchyna.sk

# ─────────────────────────────────────────────────────────────────────────
# ANALYTICS (Plausible)
# ─────────────────────────────────────────────────────────────────────────
# Optional, cookieless. On when both are set. The tracker is proxied first-party
# (next-plausible withPlausibleProxy) so ad-blockers can't block it.
# PLAUSIBLE_DOMAIN is the site's data-domain; PLAUSIBLE_SRC is the Plausible
# instance's per-site script URL — only its ORIGIN is used, as the proxy target.
# PLAUSIBLE_SRC=https://plausible.example.com/js/pa--xxxxxxxx.js
# PLAUSIBLE_DOMAIN=recipes.example.com


# ─────────────────────────────────────────────────────────────────────────
# FIRST USER SETUP
# ─────────────────────────────────────────────────────────────────────────
# On first startup, configure ONE auth provider below to create your admin account.
# After first login, use Settings => Admin to configure additional providers,
# AI settings, video parsing, and all other options.

# Option 1=Password auth - basic auth with email/password
# If not set defaults to disabled if OIDC or OAuth is configured.
# Defaults to true if no other auth providers are configured.
#PASSWORD_AUTH_ENABLED=false # Enable/disable password auth default: false

# Option 2=OIDC (Authentik, Keycloak, PocketID, etc.)
# OIDC_NAME=NoraId
# OIDC_ISSUER=https://nora.example.com
# OIDC_CLIENT_ID=<client-id>
# OIDC_CLIENT_SECRET=<client-secret>
# OIDC_WELLKNOWN=https://auth.example.com/.well-known/openid-configuration
# Wellknown is optional: By default the wellknown URL is derived from the issuer by appending /.well-known/openid-configuration

# OIDC Claim Mapping (optional) - Auto-assign roles and households based on OIDC claims
# OIDC_CLAIM_MAPPING_ENABLED=false    # Enable claim-based role/household assignment (default: false, disabled for security)
# OIDC_SCOPES=groups                   # Additional scopes to request (comma-separated, e.g., "groups" for Keycloak)
# OIDC_GROUPS_CLAIM=groups             # Claim containing user groups (default: groups)
# OIDC_ADMIN_GROUP=norish_admin        # Group that grants server admin role (default: norish_admin)
# OIDC_HOUSEHOLD_GROUP_PREFIX=norish_household_  # Prefix for household groups (default: norish_household_)

# Option 3=GitHub OAuth (uncomment and remove OIDC above)
# GITHUB_CLIENT_ID=<github-client-id>
# GITHUB_CLIENT_SECRET=<github-client-secret>

# Option 4=Google OAuth (uncomment and remove OIDC above)
# GOOGLE_CLIENT_ID=<google-client-id>
# GOOGLE_CLIENT_SECRET=<google-client-secret>
